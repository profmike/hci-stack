#!/bin/bash
# Install all hci-stack skills for Claude Code, Codex, and/or Gemini CLI
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SKILLS=(
  "hci-office-hours-with-mike"
)
VERSION_FILE="$SCRIPT_DIR/VERSION"
VERSION=$(cat "$VERSION_FILE")
HOST="${1:-auto}"
INSTALL_HOME="${HCI_STACK_INSTALL_HOME:-$HOME}"

install_skill_files() {
  local skill="$1"
  local dir="$2/$skill"
  case "$dir" in
    "$INSTALL_HOME/.claude/skills/$skill"|"$INSTALL_HOME/.codex/skills/$skill"|"$INSTALL_HOME/.gemini/skills/$skill") ;;
    *)
      echo "Refusing unexpected install destination: $dir" >&2
      exit 1
      ;;
  esac
  if [ -e "$dir" ]; then
    rm -rf -- "$dir"
  fi
  mkdir -p "$dir"
  cp -R "$SCRIPT_DIR/$skill/." "$dir/"
}

install_claude() {
  local root="$INSTALL_HOME/.claude/skills"
  local skill
  for skill in "${SKILLS[@]}"; do
    install_skill_files "$skill" "$root"
    echo "  Claude Code: $root/$skill"
  done
}

install_codex() {
  local root="$INSTALL_HOME/.codex/skills"
  local skill
  for skill in "${SKILLS[@]}"; do
    install_skill_files "$skill" "$root"
    echo "  Codex: $root/$skill"
  done
}

install_gemini() {
  local root="$INSTALL_HOME/.gemini/skills"
  local skill
  for skill in "${SKILLS[@]}"; do
    install_skill_files "$skill" "$root"
    echo "  Gemini CLI: $root/$skill"
  done
}

echo "Installing hci-stack v$VERSION..."

case "$HOST" in
  claude)
    install_claude
    ;;
  codex)
    install_codex
    ;;
  gemini)
    install_gemini
    ;;
  auto)
    # Install for whichever agents are present
    INSTALLED=0
    if [ -d "$INSTALL_HOME/.claude" ]; then
      install_claude
      INSTALLED=1
    fi
    if [ -d "$INSTALL_HOME/.codex" ]; then
      install_codex
      INSTALLED=1
    fi
    if [ -d "$INSTALL_HOME/.gemini" ]; then
      install_gemini
      INSTALLED=1
    fi
    if [ "$INSTALLED" -eq 0 ]; then
      # Default to Claude if neither exists
      install_claude
    fi
    ;;
  *)
    echo "Usage: ./install [claude|codex|gemini|auto]"
    exit 1
    ;;
esac

echo ""
echo "hci-stack v$VERSION ready."
echo "Claude: /hci-office-hours-with-mike"
echo "Codex: \$hci-office-hours-with-mike"
echo "Gemini: /hci-office-hours-with-mike"
