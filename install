#!/bin/bash
# Install hci-office-hours-with-mike skill for Claude Code and/or Codex
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SKILL_SRC_DIR="$SCRIPT_DIR/hci-office-hours-with-mike"
VERSION_FILE="$SKILL_SRC_DIR/VERSION"
if [ ! -f "$VERSION_FILE" ]; then
  VERSION_FILE="$SCRIPT_DIR/VERSION"
fi
VERSION=$(cat "$VERSION_FILE")
HOST="${1:-auto}"

install_skill_files() {
  local dir="$1"
  mkdir -p "$dir"
  cp -R "$SKILL_SRC_DIR/." "$dir/"
}

install_claude() {
  local dir="$HOME/.claude/skills/hci-office-hours-with-mike"
  install_skill_files "$dir"
  echo "  Claude Code: $dir"
}

install_codex() {
  local dir="$HOME/.codex/skills/hci-office-hours-with-mike"
  install_skill_files "$dir"
  echo "  Codex: $dir"
}

echo "Installing hci-office-hours-with-mike v$VERSION..."

case "$HOST" in
  claude)
    install_claude
    ;;
  codex)
    install_codex
    ;;
  auto)
    # Install for whichever agents are present
    INSTALLED=0
    if [ -d "$HOME/.claude" ]; then
      install_claude
      INSTALLED=1
    fi
    if [ -d "$HOME/.codex" ]; then
      install_codex
      INSTALLED=1
    fi
    if [ "$INSTALLED" -eq 0 ]; then
      # Default to Claude if neither exists
      install_claude
    fi
    ;;
  *)
    echo "Usage: ./install [claude|codex|auto]"
    exit 1
    ;;
esac

echo ""
echo "hci-office-hours-with-mike v$VERSION ready."
echo "Claude: /hci-office-hours-with-mike"
echo "Codex: \$hci-office-hours-with-mike"
